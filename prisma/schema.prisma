generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                     String         @id @default(cuid())
  email                  String         @unique
  hashedPassword         String
  fullName               String?
  companyName            String?
  companyCountry         String?
  companyAddress         String?
  plan                   String         @default("free")
  paddleCustomerId       String?
  paddleSubscriptionId   String?
  documentsUsedThisMonth Int            @default(0)
  monthlyResetDate       DateTime
  isActive               Boolean        @default(true)
  createdAt              DateTime       @default(now())
  documents              Document[]
  products               Product[]
  brokerRequests         BrokerReview[]
  tariffAlerts           TariffAlert[]
  storage                UserStorage?
  subscriptions          Subscription[]
  shops                  Shop[]
  shipmentDecisions      ShipmentDecision[]
}

model Document {
  id                    String    @id @default(cuid())
  userId                String
  filename              String
  originalFilename      String
  filePath              String
  fileSizeBytes         Int
  fileType              String
  checksumMd5           String
  documentType          String    @default("unknown")
  status                String    @default("processing")
  extractedDataJson     String    @default("{}")
  validationFlagsJson   String    @default("[]")
  confidenceScore       Int       @default(0)
  processingTimeMs      Int?
  uploadedAt            DateTime  @default(now())
  processingStartedAt   DateTime?
  processingCompletedAt DateTime?
  lastViewedAt          DateTime?
  lastExportedAt        DateTime?
  manuallyEditedAt      DateTime?
  deletedAt             DateTime?
  expiresAt             DateTime
  isArchived            Boolean   @default(false)
  archivePath           String?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerReviews         BrokerReview[]

  @@index([userId, uploadedAt])
  @@index([checksumMd5])
}

model UserStorage {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  totalBytesUsed         BigInt   @default(0)
  documentCountTotal     Int      @default(0)
  documentCountThisMonth Int      @default(0)
  storageLimitBytes      BigInt
  lastCalculatedAt       DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String
  paddleSubscriptionId String   @unique
  plan                 String
  status               String
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id                 String   @id @default(cuid())
  userId             String
  sku                String
  name               String
  customsDescription String
  hsCode             String
  countryOfOrigin    String
  material           String?
  defaultLane        String?
  confidenceNote     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tariffAlerts       TariffAlert[]

  @@unique([userId, sku])
  @@index([userId, name])
}

model TariffAlert {
  id        String   @id @default(cuid())
  userId    String
  skuId     String
  hsCode    String
  alertType String
  title     String
  body      String
  lane      String
  severity  String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sku       Product  @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([skuId])
}

model BrokerReview {
  id             String    @id @default(cuid())
  userId         String
  documentId     String
  brokerEmail    String
  clientName     String?
  note           String?
  status         String    @default("requested")
  createdAt      DateTime  @default(now())
  reviewedAt     DateTime?
  brokerFeedback String?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  document       Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([brokerEmail])
}

model Shop {
  id                String   @id @default(cuid())
  userId            String
  shopDomain        String   @unique
  accessToken       String
  scope             String?
  installedAt       DateTime @default(now())
  uninstalledAt     DateTime?
  isActive          Boolean  @default(true)
  webhookVerified   Boolean  @default(false)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders            ShopifyOrder[]
  decisions         ShipmentDecision[]

  @@index([userId])
  @@index([shopDomain])
}

model ShopifyOrder {
  id                String   @id @default(cuid())
  shopId            String
  shopDomain        String
  shopifyOrderId    String
  shopifyOrderNumber String?
  orderName         String?
  email             String?
  currency          String?
  totalPrice        String?
  subtotalPrice     String?
  totalTax          String?
  financialStatus   String?
  fulfillmentStatus String?
  destinationCountry String?
  destinationCity   String?
  shippingAddressJson String @default("{}")
  billingAddressJson  String @default("{}")
  lineItemsJson     String @default("[]")
  rawPayloadJson    String @default("{}")
  createdAt         DateTime @default(now())
  shopifyCreatedAt  DateTime?
  updatedAt         DateTime @updatedAt
  shop              Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, shopifyOrderId])
  @@index([shopDomain, shopifyCreatedAt])
  @@index([shopId, createdAt])
}

model ShipmentDecision {
  id                String   @id @default(cuid())
  userId            String
  shopId            String?
  shopDomain        String?
  shopifyOrderId    String?
  documentId        String?
  shopifyOrderNumber String?
  lane              String   @default("global")
  status            String   @default("needs_review")
  confidence        Int      @default(0)
  hsRecommendationsJson String @default("[]")
  flagsJson         String @default("[]")
  auditTrailJson    String @default("{}")
  inputJson         String @default("{}")
  outputJson        String @default("{}")
  interfazeRunId    String?
  interfazeWorkflow String?
  processingTimeMs  Int?
  brokerStatus      String   @default("not_required")
  carrierPayloadJson String @default("{}")
  invoiceGenerated  Boolean  @default(false)
  approvalStatus    String   @default("pending")
  approvedBy        String?
  approvedAt        DateTime?
  rejectionReason   String?
  brokerToken       String?  @unique
  brokerEmail       String?
  brokerNote        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop              Shop?    @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([shopId, createdAt])
  @@index([shopifyOrderId])
  @@index([status])
  @@index([approvalStatus])
}

model RestrictedRule {
  id                String   @id @default(cuid())
  category          String
  hsPrefix          String?
  hsCode            String?
  countryFrom       String?
  countryTo         String?
  lane              String?
  ruleType          String
  title             String
  body              String
  severity          String   @default("warning")
  sourceUrl         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([category, lane])
  @@index([hsPrefix])
}
