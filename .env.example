DATABASE_URL="file:./prisma/dev.db"
NEXT_PUBLIC_APP_NAME="TradeDocAI"
SECRET_KEY="change-this-to-a-random-32-character-secret"
UPLOAD_DIR="./uploads"

# Optional for full AI extraction. Without this, the app uses a local fallback parser.
AI_PROVIDER="nvidia"
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="meta/llama-3.3-70b-instruct"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash-lite"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# Reserved for Paddle Merchant of Record checkout.
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""
PADDLE_STARTER_PRICE_ID=""
PADDLE_PRO_PRICE_ID=""
PADDLE_BROKER_PRICE_ID=""
