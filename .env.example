DATABASE_URL="file:./prisma/dev.db"
NEXT_PUBLIC_APP_NAME="TradeDocAI"
SECRET_KEY="change-this-to-a-random-32-character-secret"
UPLOAD_DIR="./uploads"

# Optional for full AI extraction. Without this, the app uses a local fallback parser.
AI_PROVIDER="nvidia"
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="meta/llama-3.3-70b-instruct"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash-lite"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# Reserved for Paddle Merchant of Record checkout.
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""
PADDLE_STARTER_PRICE_ID=""
PADDLE_PRO_PRICE_ID=""
PADDLE_BROKER_PRICE_ID=""

# Shopify ClearShip OS
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_APP_URL=""
SHOPIFY_WEBHOOK_SECRET=""
SHOPIFY_SCOPES="read_orders,read_products,write_orders"

# Interfaze.AI - Deterministic workflow engine
INTERFAZE_API_KEY=""
INTERFAZE_BASE_URL="https://api.interfaze.ai/v1"
INTERFAZE_WORKFLOW_ID="clearship-decision-v1"
AI_PROVIDER="interfaze"

# Upstash Redis — for 1M webhook queue + shared rate limit (Vercel/Railway)
# Create at https://console.upstash.com/redis → copy REST URL + TOKEN
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Optional BullMQ self-hosted Redis (alternative to Upstash REST)
REDIS_URL=""
REDIS_HOST=""
REDIS_PORT="6379"
REDIS_PASSWORD=""

# Shopify App Billing (optional — maps to unified billing.ts)
SHOPIFY_STARTER_PRICE_ID=""
SHOPIFY_PRO_PRICE_ID=""
SHOPIFY_BROKER_PRICE_ID=""
